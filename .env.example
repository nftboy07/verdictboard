# VerdictBoard environment — copy the VALUES into your shell (export them);
# server.mjs / agent.mjs read process.env directly, they do not parse .env files.
#
# TESTNET ONLY. Use a wallet that holds NO mainnet funds. Ever.

# EVM private key for the testnet wallet (Ethereum Sepolia test USDC).
# If unset, the tools fall back to ../secrets/telegraph-testnet-wallet.env
# when run inside the desk's telegraph-hackathon/ working tree.
EVM_PRIVATE_KEY=

# Port for server.mjs (default 4317, binds 127.0.0.1 only)
# PORT=4317

# Server-side run cap for paid asks, in micro-USDC (default 500000 = $0.50
# per server process; the x402 per-payment cap is $0.10 regardless)
# VERDICTBOARD_RUN_CAP_UUSDC=500000

# Offline mode: 1 = serve bundled data (data/ask-log.jsonl) only.
# /api/health reports offline, /api/feed serves the local log, and
# /api/ask refuses with 503 — nothing is paid, nothing is faked.
# VERDICTBOARD_OFFLINE=1
